{
    "name": "@cordystackx/cordy_minikit",
    "version": "3.0.0",
    "publishConfig": {
        "access": "public"
    },
    "description": "Cordy Minikit - Open Source Web3 Dev Toolkit for both EVM and Non-EVM Wallets",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && pnpm run copy-css",
        "copy-css": "mkdir -p dist/css/UI_Comp && cp css/UI_Comp/styles.module.css dist/css/UI_Comp/",
        "npm-release": "pnpm publish --registry=https://registry.npmjs.org/ --access public",
        "github-release": "pnpm publish --registry=https://npm.pkg.github.com/"
    },
    "keywords": [
        "web3",
        "nextjs",
        "react",
        "wagmi",
        "viem",
        "ethers",
        "blockchain",
        "wallet-connect",
        "npm-package",
        "cordy-minikit",
        "EVM Wallets",
        "Non-EVM Wallets",
        "Stellar",
        "Coinbased"
    ],
    "author": "Marc Giestin Louis Cordova a.k.a. (CordyStackX)",
    "license": "MIT",
    "dependencies": {
        "@coinbase/wallet-sdk": "4.3.7",
        "@metamask/connect-evm": "^2.1.1",
        "@stellar/freighter-api": "^6.0.1",
        "@stellar/stellar-sdk": "^16.4.1",
        "@tanstack/react-query": "^5.104.5",
        "@walletconnect/ethereum-provider": "^2.26.0",
        "ethers": "^6.17.0",
        "next": "^16.4.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "viem": "^2.57.11",
        "wagmi": "^3.7.9"
    },
    "devDependencies": {
        "@types/node": "^25.9.9",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "next": ">=13",
        "react": ">=18",
        "react-dom": ">=18"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        }
    }
}
